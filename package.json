{
  "name": "le-maillot-ideal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boutique statique Le Maillot Idéal",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:products": "node scripts/generate-product-pages.mjs",
    "check:generated": "node scripts/generate-product-pages.mjs --check",
    "build:public": "node scripts/copy-public.mjs",
    "build:admin": "vite build --config admin-src/vite.config.js",
    "build": "npm run build:public && npm run build:admin",
    "dev:admin": "vite --config admin-src/vite.config.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-audit.mjs",
    "check": "npm run check:generated && npm run build && npm run test && npm run test:browser"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.0"
  },
  "dependencies": {
    "@vercel/functions": "3.9.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
